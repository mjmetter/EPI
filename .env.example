# Copy to .env and fill in real values. NEVER commit a populated .env.
# These are read from the environment by the collectors and the report generator.

# --- GitLab (metrics collection) ---
# API token for the GitLab instance(s) in repos.yaml. Per-product overrides are
# possible via the `token_env` field in repos.yaml (e.g. GITLAB_OTHER_TOKEN).
GITLAB_TOKEN=
# Optional explicit instance/project overrides (normally taken from repos.yaml):
GITLAB_INSTANCE=
GITLAB_PROJECT_ID=

# --- Jira (ticket type classification, optional) ---
# Format: "email@example.com:api_token" for Atlassian Cloud basic auth.
JIRA_TOKEN=

# --- Linear (ticket type classification, optional; alternative to Jira) ---
# Personal API key from Linear Settings -> API. Used as-is in the Authorization header.
LINEAR_TOKEN=

# --- Cursor analytics API (AI adoption metrics, optional) ---
CURSOR_API_TOKEN=

# --- LiteLLM / LLM spend API (AI spend metrics, optional) ---
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Dashboard chat panel (optional) ---
# ANTHROPIC_AUTH_TOKEN is read at report-generation time and embedded into the
# HTML so the in-page chat works locally. For a deployed dashboard, leave the
# __LLM_API_KEY__ / __LLM_API_ENDPOINT__ placeholders in the HTML and substitute
# them at deploy time instead of baking a secret into the committed report.
ANTHROPIC_AUTH_TOKEN=
# OpenAI-compatible chat completions endpoint the dashboard calls:
LLM_API_ENDPOINT=
